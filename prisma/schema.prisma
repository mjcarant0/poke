datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}


generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model User {
  id             String          @id @default(cuid())
  name           String
  username       String          @unique
  email          String          @unique
  password       String
  createdAt      DateTime        @default(now())
  posts          ProjectPost[]
  postUpvotes    PostUpvote[]
  commentUpvotes CommentUpvote[]
}

model ProjectPost {
  id          String       @id @default(cuid())
  title       String
  description String
  url         String
  category    String       @default("SaaS App")
  authorEmail String
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  images      String?
  upvotes     Int          @default(0)
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  comments    QAComment[]
  labels      Label[]
  upvoteList  PostUpvote[]
}

model QAComment {
  id               String          @id @default(cuid())
  postId           String
  post             ProjectPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type             String          @default("GENERAL")
  qaNotes          String
  authorName       String          @default("Anonymous")
  authorId         String?
  screenshotUrl    String?
  screenshots      String?
  pageTested       String?
  browser          String?
  os               String?
  deviceType       String?
  screenResolution String?
  referrer         String?
  timestamp        String?
  status           String          @default("NEW")
  upvotes          Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  labels           CommentLabel[]
  replies          QAReply[]
  upvoteList       CommentUpvote[]
}

model PostUpvote {
  id        String      @id @default(cuid())
  postId    String
  post      ProjectPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([postId, userId])
}

model CommentUpvote {
  id        String    @id @default(cuid())
  commentId String
  comment   QAComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([commentId, userId])
}

model QAReply {
  id         String    @id @default(cuid())
  commentId  String
  comment    QAComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  authorName String    @default("Reviewer")
  authorRole String    @default("REVIEWER") // "DEVELOPER" or "REVIEWER"
  content    String
  createdAt  DateTime  @default(now())
}

model Label {
  id       String         @id @default(cuid())
  postId   String
  post     ProjectPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  name     String
  color    String         @default("#3b82f6")
  comments CommentLabel[]
}

model CommentLabel {
  id        String    @id @default(cuid())
  commentId String
  comment   QAComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label     @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([commentId, labelId])
}
